# ── Cloud LLM Configuration ────────────────────────────────────────────────
# All models MUST include the :cloud or -cloud suffix (enforced at startup).
# The backend will refuse to start if REQUIRE_CLOUD_MODELS=true and any model
# lacks the cloud suffix.

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
SUPERVISOR_MODEL=glm-5.1:cloud
CODER_MODEL=qwen3-coder:480b-cloud
RESEARCHER_MODEL=minimax-m3:cloud
REVIEWER_MODEL=glm-5.1:cloud

# ── Cloud Validation ────────────────────────────────────────────────────────
# REQUIRE_CLOUD_MODELS=true  → refuse startup if any model is not :cloud/-cloud
# REQUIRE_CLOUD_MODELS=false → allow any model name (dev/experimental only)
REQUIRE_CLOUD_MODELS=true

# CLOUD_VALIDATION_DISABLED=true → skip cloud model check entirely (CI/testing)
CLOUD_VALIDATION_DISABLED=false

# ── Fallback Mode (tests only) ──────────────────────────────────────────────
# FORCE_FALLBACK=true  → use deterministic fallback (no cloud calls — for unit tests)
# FORCE_FALLBACK=false → always call cloud models; raise CloudModelError on failure
FORCE_FALLBACK=false

# ── API & Infrastructure ────────────────────────────────────────────────────
AGENT_PORT=8100
RAG_API_URL=http://127.0.0.1:8000
CLOUD_API_KEY=ollama

# ── Trace Storage ────────────────────────────────────────────────────────────
TRACE_DB_PATH=data/traces.db